#!/bin/bash
#PBS -N Relaxed_States_Generation
#PBS -q workq
#PBS -l walltime=12:00:00
#PBS -l nodes=master:ppn=64
#PBS -l mem=64gb
#PBS -m aeb
#PBS -M palashsarate@iisc.ac.in
# Standard output file
#PBS -o PBS_Output/generate_relaxed_states.log
# Standard error file
#PBS -e PBS_Output/generate_relaxed_states_err.log

## Specify the shell to be bash
#PBS -S /bin/bash

# ==============================================================================
# PBS Script to Generate Relaxed Chain Library
# Optimized for AMD EPYC (Zen 4) + NVIDIA RTX A6000
# ==============================================================================

# 1. Set working directory to the project root
## Change to directory the PBS script was submitted from
cd $PBS_O_WORKDIR

# 2. Activate the conda environment with the optimized LAMMPS build
echo "=== 2. ENVIRONMENT CHECK ==="
source /home/guest/miniconda3/etc/profile.d/conda.sh
conda activate gchain

echo "Python Path: $(which python)"
python --version
echo ""

# 3. Loop through chain lengths N = 4, 12, 24, 48
# Each length will have 100 independent relaxed states generated.
# Parallelism: Using 64 threads per state to maximize EPYC/KOKKOS performance.

for N in 4 12 24 48
do
    echo "------------------------------------------------------------------------------"
    echo "Starting Library Generation for N = $N (100 states)"
    echo "Started at: $(date)"
    echo "------------------------------------------------------------------------------"
    
    python -u main.py generate_relaxed_library \
        --n_beads $N \
        --n_states 100 \
        --num_procs 64 \
        --num_threads 1 \
        --forced
        
    echo "Finished N = $N at: $(date)"
done

echo "=============================================================================="
echo "All relaxed states generated successfully."
echo "=============================================================================="
