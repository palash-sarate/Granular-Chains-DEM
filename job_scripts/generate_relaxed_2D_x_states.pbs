#!/bin/bash
#PBS -N Relaxed_2D_States_Generation
#PBS -q workq
#PBS -l walltime=12:00:00
#PBS -l nodes=master:ppn=64
#PBS -l mem=128gb
#PBS -m aeb
#PBS -M palashsarate@iisc.ac.in
# Standard output file
#PBS -o PBS_Output/generate_relaxed_2D_x_states.log
# Standard error file
#PBS -e PBS_Output/generate_relaxed_2D_x_states_err.log

## Specify the shell to be bash
#PBS -S /bin/bash

# ==============================================================================
# PBS Script to Generate 2D Relaxed Chain Library (YZ Plane)
# Optimized for AMD EPYC (Zen 4) + NVIDIA RTX A6000
# ==============================================================================

# 1. Set working directory to the project root
cd $PBS_O_WORKDIR

# 2. Activate environment
source /home/guest/miniconda3/etc/profile.d/conda.sh
conda activate gchain

echo "Starting 2D Library Generation at: $(date)"

# 3. Loop through chain lengths
for N in 4 8 10 12 24 48 100
do
    echo "------------------------------------------------------------------------------"
    echo "Starting 2D Library Generation for N = $N (100 states)"
    echo "------------------------------------------------------------------------------"
    
    python -u main.py generate_relaxed_library \
        --n_beads $N \
        --n_states 50 \
        --inParallel 64 \
        --num_procs 1 \
        --num_threads 1 \
        --template "in.relax_2d_gen" \
        --dump_inc "simulation_templates/quiet_dump.inc" \
        --output_dir "chain_data/relaxed_2D_x" \
        --run_name_prefix "relax_N${N}_2D_x" \
        --simulation_name "Relax_2D_Library_Gen" \
        --no-kokkos \
        --forced
        
    echo "Finished N = $N at: $(date)"
done

echo "=============================================================================="
echo "All 2D relaxed states generated successfully."
echo "=============================================================================="
