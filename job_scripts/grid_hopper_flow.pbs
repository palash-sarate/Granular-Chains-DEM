#!/bin/bash
#PBS -N Grid_Hopper_Flow
#PBS -q workq
#PBS -l walltime=48:00:00
#PBS -l nodes=master:ppn=64
#PBS -l mem=128gb
#PBS -m aeb
#PBS -M palashsarate@iisc.ac.in
# Standard output file
#PBS -o PBS_Output/grid_hopper_flow.log
# Standard error file
#PBS -e PBS_Output/grid_hopper_flow_err.log

## Specify the shell to be bash
#PBS -S /bin/bash

# ==============================================================================
# PBS Script for Grid Hopper Flow (Oscillatory Flow Transition)
# ==============================================================================

# 1. Set working directory to the project root
cd $PBS_O_WORKDIR

# 2. Activate environment
source /home/guest/miniconda3/etc/profile.d/conda.sh
conda activate gchain

# 3. Path to the source filling simulation directory
# Example: dumping_yard/Grid_Hopper_Filling_test/Grid_Fill_5H_MixedN_S408796
SOURCE_DIR="REPLACE_WITH_ACTUAL_SOURCE_DIR"

echo "Starting Grid Hopper Flow Simulation at: $(date)"

# Transition filled hoppers to oscillatory flow.
# Orifices will be opened and walls will begin oscillating.
python -u main.py run_grid_hopper_flow \
    --source_dir "$SOURCE_DIR" \
    --run_steps 10000 \
    --viscosity 0.005 \
    --freq 2,4,8,10 \
    --amp 0.01,0.02,0.01,0.03 \
    --osc_dir z \
    --dt 1e-6 \
    --num_procs 16 \
    --num_threads 1 \
    --simulation "Grid_Hopper_Flow" \
    --dump_file "simulation_templates/default_dump.inc"

echo "=============================================================================="
echo "Flow simulation and splitting complete at: $(date)"
echo "=============================================================================="
