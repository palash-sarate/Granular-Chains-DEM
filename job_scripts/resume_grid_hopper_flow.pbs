#!/bin/bash
#PBS -N Grid_Hopper_Flow_Resume
#PBS -q workq
#PBS -l walltime=48:00:00
#PBS -l nodes=master:ppn=64
#PBS -l mem=128gb
#PBS -m aeb
#PBS -M palashsarate@iisc.ac.in
# Standard output file
#PBS -o PBS_Output/grid_hopper_flow_resume.log
# Standard error file
#PBS -e PBS_Output/grid_hopper_flow_resume_err.log

## Specify the shell to be bash
#PBS -S /bin/bash

# ==============================================================================
# PBS Script for Resuming Grid Hopper Flow
# ==============================================================================

# 1. Set working directory to the project root
cd $PBS_O_WORKDIR

# 2. Activate environment
source /home/guest/miniconda3/etc/profile.d/conda.sh
conda activate gchain

# 3. Path to the latest flow restart file
# Example: dumping_yard/Grid_Hopper_Flow/Grid_Flow_5H_S12345/restart/restart.final.bin
RESTART_FILE="REPLACE_WITH_ACTUAL_RESTART_PATH"

echo "Resuming Grid Hopper Flow at: $(date)"

python -u main.py resume_grid_hopper_flow \
    --restart_path "$RESTART_FILE" \
    --run_steps 1000000 \
    --dt 1e-6 \
    --num_procs 16 \
    --num_threads 1

echo "=============================================================================="
echo "Resume and splitting complete at: $(date)"
echo "=============================================================================="
