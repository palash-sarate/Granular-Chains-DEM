#!/bin/bash
#PBS -N Grid_Hopper_Mixed
#PBS -q workq
#PBS -l walltime=48:00:00
#PBS -l nodes=master:ppn=64
#PBS -l mem=128gb
#PBS -m aeb
#PBS -M palashsarate@iisc.ac.in
# Standard output file
#PBS -o PBS_Output/grid_hopper_fill.log
# Standard error file
#PBS -e PBS_Output/grid_hopper_fill_err.log

## Specify the shell to be bash
#PBS -S /bin/bash

# ==============================================================================
# PBS Script for Batch Hopper Filling (Super-Simulation)
# ==============================================================================

# 1. Set working directory to the project root
cd $PBS_O_WORKDIR

# 2. Activate environment
source /home/guest/miniconda3/etc/profile.d/conda.sh
conda activate gchain

# 3. Launch Simulation
echo "Starting Batch Grid Hopper Filling at: $(date)"

# Launch grid filling for multiple hoppers simultaneously.
# Full list of available parameters:
python -u main.py run_grid_hopper_filling \
    --n_hoppers 4 \
    --n_fill 6000,4000,6000,4000 \
    --N 4,8,4,8 \
    --spacing 2.0 \
    --relax_steps 100001 \
    --dt 1e-6 \
    --viscosity 0.001 \
    --hopper_template_data "simulation_geometries/2D_hopper.inc" \
    --dump_file "simulation_templates/quiet_dump.inc" \
    --simulation "Grid_Hopper_Filling_Mixed" \
    --geometry_vars '{"y_half": [0.155, 0.25], "orifice_half": [0.05, 0.08, 0.1]}' \
    --num_procs 16 \
    --num_threads 1 \
    --mode 2D_stacked

echo "=============================================================================="
echo "Batch filling and splitting complete at: $(date)"
echo "=============================================================================="
