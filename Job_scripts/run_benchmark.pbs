#!/bin/bash
#PBS -N Scaling_Benchmark
#PBS -q workq
#PBS -l walltime=06:00:00
#PBS -l nodes=master:ppn=64
#PBS -l mem=128gb
#PBS -o PBS_Output/scaling_benchmark.log
#PBS -e PBS_Output/scaling_benchmark_err.log

cd $PBS_O_WORKDIR
source /home/guest/miniconda3/etc/profile.d/conda.sh
conda activate gchain

echo "Starting Performance Benchmark at $(date)"
python -u benchmark_performance.py
echo "Performance Benchmark Finished at $(date)"
