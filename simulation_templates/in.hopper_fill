# Fill-only hopper template: fill, relax, save (no oscillation)
# Expects variables: outdir, mol_include_file, n_templates, n_fill, drop_steps,
# relax_steps, dt, seed, lepton_inc

units       si
atom_style hybrid sphere angle
boundary    f f f

comm_modify vel yes cutoff 0.004
special_bonds lj/coul 1.0 1.0 1.0

# Box and topology
region sim_box block -0.5 0.5 -0.25 0.25 -0.1 0.6
create_box 1 sim_box bond/types 1 angle/types 1 extra/bond/per/atom 2 extra/angle/per/atom 2 extra/special/per/atom 2

fix 1 all gravity 9.81 vector 0 0 -1

include ${lepton_inc}

include ${setup_inc}

# Molecules
include ${mol_include_file}

# Settings
neighbor 0.004 bin
neigh_modify delay 0 every 1 check yes
timestep ${dt}

group chain_particles dynamic all region sim_box
fix 2 all viscous ${viscosity}

# Use the standard NVE integrator for the mobile beads only.
fix 3 all nve/sphere

include ${dump_inc}

# --- Pre-fill: drop single spheres to seed the hopper floor ---
# variable n_singles equal 20          # number of single beads to drop first
# variable js loop ${n_singles}
# label single_loop_start
#     variable rxs equal random(-0.08, 0.08,  ${seed})
#     variable rys equal random(-0.155, 0.155, ${seed})
#     create_atoms 1 single ${rxs} ${rys} 0.48
#     set atom $(count(all)) diameter 0.002 mass 2.96763e-05
#     run ${drop_steps}
#     next js
# jump SELF single_loop_start

# Fill loop
variable i loop ${n_fill}
label loop_start
    variable r equal floor(random(1,${n_templates}+1,${seed}))
    variable mol_id string m${r}
    variable rx equal random(-0.08,0.08,${seed})
    variable ry equal random(-0.155, 0.155, ${seed})
    create_atoms 0 single ${rx} ${ry} 0.5 mol ${mol_id} ${seed}
    run ${drop_steps}
    next i
jump SELF loop_start

# Relax the filled hopper
run ${relax_steps}

# Save state
write_data ${outdir}/final_hopper.data
write_restart ${outdir}/restart/restart.fill.bin
