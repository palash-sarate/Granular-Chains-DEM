# Fill-only hopper template: fill, relax, save (no oscillation)
# Expects variables: outdir, mol_include_file, n_templates, n_fill, drop_steps,
# relax_steps, dt, seed, lepton_inc

units       si
atom_style hybrid sphere angle
boundary    f f f

comm_modify vel yes cutoff 0.01
special_bonds lj/coul 1.0 1.0 1.0

# Box and topology
region sim_box block -0.5 0.5 -0.25 0.25 -0.1 0.6
create_box 1 sim_box bond/types 1 angle/types 1 extra/bond/per/atom 2 extra/angle/per/atom 2 extra/special/per/atom 10

fix 1 all gravity 9.81 vector 0 0 -1

include ${lepton_inc}

include ${setup_inc}

# Molecules
include ${mol_include_file}

# Settings
neighbor 0.01 bin
neigh_modify delay 0 every 1 check yes
timestep ${dt}

group chain_particles dynamic all region sim_box
fix 2 all viscous ${viscosity}

# Use the standard NVE integrator for the mobile beads only.
fix 3 all nve/sphere

include ${dump_inc}

# --- Trigger logic variables ---
# variable z_target_min equal ${z_bin_top}-0.01
# variable z_target_max equal ${z_bin_top}+0.01
# variable in_target_zone atom "z > v_z_target_min && z < v_z_target_max"
# compute check_zone all reduce max v_in_target_zone
# variable any_in_zone equal c_check_zone

# --- Pre-fill: drop single spheres to seed the hopper floor ---
# variable n_singles equal 20          # number of single beads to drop first
# variable js loop ${n_singles}
# label single_loop_start
#     variable rxs equal random(-0.08, 0.08,  ${seed})
#     variable rys equal random(-0.155, 0.155, ${seed})
#     create_atoms 1 single ${rxs} ${rys} 0.48
#     set atom $(count(all)) diameter 0.002 mass 2.96763e-05
#     run ${drop_steps}
#     next js
# jump SELF single_loop_start

restart ${drop_steps} ${outdir}/restart/restart.*.bin

# Fill loop
variable i loop ${n_fill}
label loop_start
    variable r equal floor(random(1,${n_templates}+1,${seed}))
    variable mol_id string m${r}
    variable rx equal random(-0.08,0.08,${seed})
    variable ry equal random(-0.155, 0.155, ${seed})
    create_atoms 0 single ${rx} ${ry} 0.55 mol ${mol_id} ${seed}

    # Check if any atom is in the high-resolution zone
    # run 0
    # if "${any_in_zone} > 0" then &
    #     "undump 1" &
    #     "undump 2" &
    #     "undump 3" &
    #     "dump 1 all custom 10 ${outdir}/chain/chain_*.dump id type x y z vx vy vz fx fy fz diameter mass" &
    #     "dump_modify 1 sort id" &
    #     "dump 2 all local 10 ${outdir}/bond/bond_*.dump index c_1[1] c_1[2] c_1[3]" &
    #     "dump_modify 2 colname 2 dist" &
    #     "dump_modify 2 colname 3 energy" &
    #     "dump_modify 2 colname 4 force" &
    #     "dump 3 all local 10 ${outdir}/angle/angle_*.dump index c_2[1] c_2[2]" &
    #     "dump_modify 3 colname 2 theta" &
    #     "dump_modify 3 colname 3 energy" &
    #     "run ${relax_steps}" &
    # else &
    #     "undump 1" &
    #     "undump 2" &
    #     "undump 3" &
    #     "dump 1 all custom 1000 ${outdir}/chain/chain_*.dump id type x y z vx vy vz fx fy fz diameter mass" &
    #     "dump_modify 1 sort id" &
    #     "dump 2 all local 1000 ${outdir}/bond/bond_*.dump index c_1[1] c_1[2] c_1[3]" &
    #     "dump_modify 2 colname 2 dist" &
    #     "dump_modify 2 colname 3 energy" &
    #     "dump_modify 2 colname 4 force" &
    #     "dump 3 all local 1000 ${outdir}/angle/angle_*.dump index c_2[1] c_2[2]" &
    #     "dump_modify 3 colname 2 theta" &
    #     "dump_modify 3 colname 3 energy"

    run ${drop_steps}
    next i
jump SELF loop_start

restart 100000 ${outdir}/restart/restart.*.bin

run ${relax_steps}

# Save state
write_data ${outdir}/final_hopper.data
write_restart ${outdir}/restart/restart.final.bin
