# Flexible granular chain simulation in LAMMPS (Resume Stage)
# Automatically generated by Generalized Engine

units       si
atom_style hybrid sphere angle
boundary    f f f

# Read restart binary
read_restart {{resume_file}}

# Re-define anchors and mobile groups
group anchors id 1 2
group mobile subtract all anchors

# Include Lepton potentials
include {{includes_lepton_inc}}

# Apply gravity in the standard downward (−z) direction
fix grav mobile gravity 9.81 vector 0 0 -1

group chain_particles type 1
fix 1 chain_particles viscous {{viscosity}}

comm_modify vel yes cutoff 0.004

# Standard NVE integrator for mobile beads
fix integr mobile nve/sphere

# Neighbor list settings
neighbor 0.004 bin
neigh_modify delay 0 every 1 check yes

# Timestep size
timestep {{dt}}

# Include dumping profiles
include {{includes_dump_inc}}

# Save a binary restart file periodically
restart 100000 {{outdir}}/restart/restart.*.bin

# Run simulation
run {{run_steps}}

# Save final state
write_restart {{outdir}}/restart/restart.final.bin
