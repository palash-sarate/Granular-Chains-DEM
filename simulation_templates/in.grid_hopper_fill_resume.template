# LAMMPS Grid-Based Batch Hopper Filling Template (Resume)
# Automatically generated by Generalized Engine

units       si
atom_style hybrid sphere angle
boundary    f f f

# Load restart binary
read_restart {{resume_file}}

# Physics & Potential
fix 1 all gravity 9.81 vector 0 0 -1
include {{includes_lepton_inc}}

# Re-apply replicated hopper boundary forces (not saved in restart)
include {{includes_geometry_inc}}

# Neighbors & Timestep settings
neighbor 0.005 bin
atom_modify sort 0 0.0
neigh_modify delay 0 every 10 check yes one 10000
timestep {{dt}}

group chain_particles type 1
group hopper_walls type 2

# Langevin integration settings
fix 2 chain_particles viscous {{viscosity}}
fix 3 chain_particles nve/sphere
fix 2D chain_particles setforce 0 NULL NULL

# Include dumping profiles
include {{includes_dump_inc}}
restart 200000 {{outdir}}/restart/restart.*.bin

# Run remaining steps
run {{relax_steps}}

# Save final state data
write_data {{outdir}}/final_grid.data
write_restart {{outdir}}/restart/restart.final.bin
