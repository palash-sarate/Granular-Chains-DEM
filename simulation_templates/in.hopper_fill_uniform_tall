# Fill-only hopper template: fill, relax, save (no oscillation)
# Expects variables: outdir, mol_include_file, n_templates, n_fill, drop_steps,
# relax_steps, dt, seed, lepton_inc

units       si
atom_style hybrid sphere angle
boundary    f f f

comm_modify vel yes cutoff 0.01
special_bonds lj/coul 1.0 1.0 1.0

# Box and topology
# Use a dynamic box height to accommodate the tall insertion column
variable z_box_top equal 0.6
if "$(is_defined(variable,z_max))" then "variable z_box_top equal $(v_z_max+0.5)"

region sim_box block -0.5 0.5 -0.25 0.25 -0.1 ${z_box_top}
create_box 1 sim_box bond/types 1 angle/types 1 extra/bond/per/atom 2 extra/angle/per/atom 2 extra/special/per/atom 10

fix 1 all gravity 9.81 vector 0 0 -1

include ${lepton_inc}
# Dynamic timestep based on Lepton smoothing width 'w'
# fix 5 all dt/reset 1 ${dt} 1e-04 ${w} units box

include ${setup_inc}

# Molecules
include ${mol_include_file}

# Settings
neighbor 0.01 bin
neigh_modify delay 0 every 10 check yes
timestep ${dt}

group chain_particles dynamic all region sim_box
fix 2 all viscous ${viscosity}

# Use the standard NVE integrator for the mobile beads only.
fix 3 all nve/sphere

include ${dump_inc}

# --- Grid Insertion Logic ---
# Exclusion zone diameter in meters: 3 * (atoms per chain) * 1mm
variable chain_size equal ${N}           # IMPORTANT: Passed from hopper_manager
variable max_batch_size equal 20      # Cap for stability

variable ex_diam equal 3*${chain_size}*0.001
variable time_gap equal 2*sqrt(${ex_diam}/9.81)
variable drop_steps equal floor(${time_gap}/${dt})

variable z_drop equal 0.51
variable drop_time equal sqrt(${z_drop}/9.81)
variable finish_drop_steps equal floor(${drop_time}/${dt})

variable x_f_min equal -0.08
variable x_f_max equal 0.08
variable x_width equal v_x_f_max-v_x_f_min
variable y_f_min equal -0.15
variable y_f_max equal 0.15
variable y_width equal v_y_f_max-v_y_f_min

# Calculate available grid cells
variable nx equal floor( v_x_width / v_ex_diam )
variable ny equal floor( v_y_width / v_ex_diam )
variable grid_total equal v_nx*v_ny

# Determine batch size (capped) using compatible if/then logic
variable batch_size equal ${grid_total}
if "${grid_total} > ${max_batch_size}" then &
    "variable batch_size equal ${max_batch_size}"

# Re-calculate grid spacing based on actual batch size to spread them out
variable nx_b equal floor( sqrt( v_batch_size * v_x_width / v_y_width ) )
# Ensure nx_f is at least 1
variable nx_f equal ${nx_b}
if "${nx_b} == 0" then "variable nx_f equal 1"

variable ny_f equal floor( v_batch_size / v_nx_f )
# actual_batch is limited by our grid math
variable actual_batch equal v_nx_f*v_ny_f

variable dx equal v_x_width/v_nx_f
variable dy equal v_y_width/v_ny_f

print ">>> Multi-chain Pour Configuration (Uniform) <<<"
print ">>> Exclusion Diameter: ${ex_diam} m"
print ">>> Batch Grid: ${nx_f} x ${ny_f} (${actual_batch} chains per drop)"
print ">>> Drop Steps: ${drop_steps}"



# --- Insertion and Relaxation ---
include ${insertion_file}

# Calculate free-fall steps for the top-most particle to reach the hopper top
variable z_target equal 0.4
if "$(is_defined(variable,z_bin_top))" then "variable z_target equal ${z_bin_top}"

variable fall_time equal sqrt(2*(v_z_max-v_z_target)/9.81)
variable fall_steps equal floor(v_fall_time/${dt})

print ">>> Top particle at z=${z_max}, falling to z=${z_target} in ${fall_steps} steps"

# Setup periodic restarts (e.g., every 50,000 steps)
restart 50000 ${outdir}/restart/restart.*.bin

# 1. Initial fall phase
run ${fall_steps}

# 2. Main relaxation run
run ${relax_steps}

# Save state
write_data ${outdir}/final_hopper.data
write_restart ${outdir}/restart/restart.final.bin
