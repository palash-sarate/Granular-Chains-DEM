# LAMMPS Grid-Based Batch Hopper Filling Template
# Analytical Geometry Version

units       si
atom_style hybrid sphere angle
boundary    f f f

comm_modify vel yes cutoff 0.02
special_bonds lj/coul 1.0 1.0 1.0

# 1. Initialize Box & Types
# We calculate a box large enough to hold the grid
variable pad equal 2.0
variable grid_nx equal ceil(sqrt(${n_hoppers}))
variable grid_ny equal ceil(${n_hoppers}/${grid_nx})
variable box_x equal (${grid_nx}*${spacing}+${pad})
variable box_y equal (${grid_ny}*${spacing}+${pad})
variable box_z equal (${z_max}+${pad})

region sim_box block -${pad} ${box_x} -${pad} ${box_y} -${pad} ${box_z}
create_box 2 sim_box bond/types 1 angle/types 1 extra/bond/per/atom 2 extra/angle/per/atom 1 extra/special/per/atom 10

# 2. Physics & Potential
fix 1 all gravity 9.81 vector 0 0 -1
include ${lepton_inc}
# Dynamic timestep based on Lepton smoothing width 'w'
# fix 5 all dt/reset 1 ${dt} 1e-04 ${w} units box

# 3. Load Analytical Geometry (Replicated Regions & Fixes)
include ${geometry_inc}

# 4. Molecules Definitions
include ${mol_include_file}

# 5. Settings
neighbor 0.005 bin
atom_modify sort 0 0.0
neigh_modify delay 0 every 10 check yes one 10000
timestep ${dt}

# 6. Massive Multi-Hopper Insertion
include ${insertion_file}

group chain_particles type 1
group hopper_walls type 2

# Only integrate the chains; hoppers remain static
fix 2 chain_particles viscous ${viscosity}
fix 3 chain_particles nve/sphere
fix 2D chain_particles setforce 0 NULL NULL

# Include the external dump settings
include ${dump_inc}
restart 200000 ${outdir}/restart/restart.*.bin

# 7. Settling Phase
run ${relax_steps}

# 8. Save Final Grid State
write_data ${outdir}/final_grid.data
write_restart ${outdir}/restart/restart.final.bin