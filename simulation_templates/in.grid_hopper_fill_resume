# LAMMPS Grid-Based Batch Hopper Filling Resume Template
# Analytical Geometry Version

units       si
atom_style hybrid sphere angle
boundary    f f f

comm_modify vel yes cutoff 0.02
special_bonds lj/coul 1.0 1.0 1.0

# 1. Load State
read_restart ${restart_path}

# 2. Re-establish Physics & Potential
fix 1 all gravity 9.81 vector 0 0 -1
include ${lepton_inc}
# Dynamic timestep based on Lepton smoothing width 'w'
fix 5 all dt/reset 1 ${dt} 1e-04 ${w} units box

# 3. Load Analytical Geometry (MUST be re-included for restarts)
include ${geometry_inc}

# 4. Re-define Settings & Groups
neighbor 0.005 bin
atom_modify sort 0 0.0
neigh_modify delay 0 every 10 check yes one 10000
timestep ${dt}

group chain_particles type 1
group hopper_walls type 2

# Re-apply integrations and constraints
fix 2 chain_particles viscous ${viscosity}
fix 3 chain_particles nve/sphere
fix 2D chain_particles setforce 0 NULL NULL

# Include the external dump settings
include ${dump_inc}
restart 100000 ${outdir}/restart/restart.*.bin

# 5. Continue Settling Phase
run ${relax_steps}

# 6. Save Final Grid State
write_data ${outdir}/final_grid.data
write_restart ${outdir}/restart/restart.final.bin
