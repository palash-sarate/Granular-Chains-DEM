# Run-from-saved hopper template: read saved state (data or restart) and run oscillating flow
# Expects: outdir, data_file (optional), restart_file (optional), lepton_inc, v_freq, v_amp, dt, run_steps

units       si
atom_style hybrid sphere angle
boundary    f f f

comm_modify vel yes cutoff 0.004
special_bonds lj/coul 1.0 1.0 1.0

# Read saved state: prefer restart_file if provided
if "${restart_file}" != "" then "read_restart ${restart_file}"
if "${restart_file}" == "" then "read_data ${data_file}" 

include ${lepton_inc}
# Dynamic timestep based on Lepton smoothing width 'w'
# fix 5 all dt/reset 1 ${dt} 1e-04 ${w} units box

group chain_particles type 1
fix 1 chain_particles viscous ${viscosity}

# Oscillation variables
variable x_osc equal "v_amp * sin(2*PI*v_freq*time)"
variable zero equal 0.0

include ${setup_inc}

neighbor 0.004 bin
neigh_modify delay 0 every 1 check yes
timestep ${dt}

fix 1 all nve/sphere
fix 2 all gravity 9.81 vector 0 0 -1

# Run oscillating flow
run ${run_steps}
