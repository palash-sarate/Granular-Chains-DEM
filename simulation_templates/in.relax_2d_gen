# 3D Relaxation of granular chain using Langevin dynamics

units       si
atom_style hybrid sphere angle
boundary    f f f

comm_modify vel yes cutoff 0.004
special_bonds lj/coul 1.0 1.0 1.0

# Variables passed from runner:
# outdir, data_file, seed, run_steps, dt, temperature

# Default temperature if not set (approx 1e12 K for macroscopic particles)
# if "${temperature} == 0" then "variable temperature equal 1e12"

read_data ${data_file}

# --- FORCE FIELD (Same as chain_flop) ---
include ${lepton_inc}
# Dynamic timestep based on Lepton smoothing width 'w'
# fix 5 all dt/reset 1 ${dt} 1e-04 ${w} units box

neighbor 0.004 bin
neigh_modify delay 0 every 1 check yes

group chain_particles type 1
# fix 1 chain_particles viscous ${viscosity}
# fix 1 chain_particles nve/sphere

timestep ${dt}

include ${dump_inc}

# Step 1: give motion
# Initialize velocities
# Initialize velocities and restrict to Y-Z plane
velocity all create ${temperature} ${seed}
velocity all set 0.0 NULL NULL
fix freeze_x all setforce 0.0 NULL NULL

fix 1 all nve
run ${motion_steps}

# Step 2: let system explore
run ${explore_steps}

# Step 3: relax
fix 2 all viscous 10.0
run ${viscous_relax_steps}

# Step 4: final minimization
minimize 1e-12 1e-12 10000 100000

# Write the final state
write_data ${outdir}/relaxed_chain.data
