# 3D Relaxation of granular chain using Langevin dynamics
# Automatically generated by Generalized Engine

units       si
atom_style hybrid sphere angle
boundary    f f f

comm_modify vel yes cutoff 0.004
special_bonds lj/coul 1.0 1.0 1.0

# Read linear starting configuration
read_data {{data_file}}

# Include Lepton potentials
include {{includes_lepton_inc}}

neighbor 0.004 bin
neigh_modify delay 0 every 1 check yes

group chain_particles type 1

timestep {{dt}}

# Include dumping profiles
include {{includes_dump_inc}}

# Step 1: Heat the system to induce motion
velocity all create {{temperature}} {{seed}} dist gaussian
fix 1 all nve
run {{motion_steps}}

# Step 2: Thermal exploration
run {{explore_steps}}

# Step 3: Viscous quench
fix 2 all viscous {{quench_viscosity}}
run {{viscous_relax_steps}}

# Step 4: Final energy minimization to settle links
minimize 1e-12 1e-12 10000 100000

# Write the final relaxed chain coordinates as a standard LAMMPS data file
write_data {{outdir}}/relaxed_chain.data
